{
  "name": "window",
  "version": "0.1.7",
  "private": true,
  "description": "Monorepo for desktop viewer apps",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "maplibre-gl": "^6.15.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "maplibre-gl": "$maplibre-gl",
    "typescript": "$typescript"
  }
}
