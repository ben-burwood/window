{
  "name": "window",
  "version": "0.1.6",
  "private": true,
  "description": "Monorepo for four desktop file-viewer apps (data-framer, map-windower, doc-viewer, image-shutter).",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "maplibre-gl": "^6.15.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "maplibre-gl": "$maplibre-gl",
    "typescript": "$typescript"
  }
}
