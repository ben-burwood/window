{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "map-windower",
  "version": "../package.json",
  "identifier": "com.map-windower.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "map-windower",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["geojson"],
        "name": "GeoJSON",
        "description": "GeoJSON",
        "role": "Viewer"
      },
      {
        "ext": ["pmtiles"],
        "name": "PMTiles",
        "description": "PMTiles map archive",
        "role": "Viewer"
      },
      {
        "ext": ["geoparquet"],
        "name": "GeoParquet",
        "description": "GeoParquet vector data",
        "role": "Viewer"
      }
    ]
  }
}
