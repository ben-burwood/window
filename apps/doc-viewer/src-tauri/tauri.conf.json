{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doc-viewer",
  "identifier": "com.doc-viewer.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "doc-viewer",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF", "description": "Portable Document Format", "role": "Viewer" }
    ]
  }
}
